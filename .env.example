# ══════════════════════════════════════════════════════════════
#  Honeypot Platform — Configuración de entorno
#  Copia este fichero como .env y cambia TODOS los valores
#  marcados con ⚠ CAMBIAR ESTO antes de arrancar en producción
# ══════════════════════════════════════════════════════════════

# ─── Base de datos ────────────────────────────────────────────
POSTGRES_DB=honeypot_db
POSTGRES_USER=honeypot_user
POSTGRES_PASSWORD=CAMBIAR_ESTO_password_segura   # ⚠ CAMBIAR ESTO

DATABASE_URL=postgresql+asyncpg://honeypot_user:CAMBIAR_ESTO_password_segura@db:5432/honeypot_db
DATABASE_SYNC_URL=postgresql://honeypot_user:CAMBIAR_ESTO_password_segura@db:5432/honeypot_db

# ─── Seguridad JWT ────────────────────────────────────────────
# Genera un valor aleatorio con: openssl rand -hex 32
SECRET_KEY=CAMBIAR_ESTO_clave_secreta_aleatoria_minimo_32_caracteres   # ⚠ CAMBIAR ESTO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Admin inicial ────────────────────────────────────────────
# Se crea automáticamente al primer arranque si no existe ningún admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tuempresa.com                  # ⚠ CAMBIAR ESTO
ADMIN_PASSWORD=CAMBIAR_ESTO_contrasena_admin     # ⚠ CAMBIAR ESTO

# ─── Dominio y CORS ───────────────────────────────────────────
DOMAIN=localhost                                 # ⚠ CAMBIAR ESTO (ej: honeypot.tuempresa.com)
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1
VITE_API_URL=/api

# ─── SMTP para alertas por email (Fase 3) ────────────────────
# SMTP_HOST=smtp.tuempresa.com
# SMTP_PORT=587
# SMTP_USER=alertas@tuempresa.com
# SMTP_PASSWORD=CAMBIAR_ESTO
# SMTP_FROM=alertas@tuempresa.com
